generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SEEKER
  EMPLOYER
  FREELANCER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  VOLUNTEER
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  FILLED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
  OFF
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  role         Role              @default(SEEKER)
  passwordHash String?
  company      Company?          @relation(fields: [companyId], references: [id])
  companyId    String?
  profile      CandidateProfile?
  applications Application[]
  savedJobs    SavedJob[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([companyId])
}

model CandidateProfile {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String         @unique
  phone           String?
  city            String?
  state           String?
  zip             String?
  headline        String?
  desiredTitles   String[]
  categories      String[]
  jobTypes        JobType[]
  workModes       WorkMode[]
  yearsExperience String?
  education       String?
  linkedin        String?
  bio             String?
  resumeName      String?
  resumeUrl       String?
  headshotName    String?
  portfolioNames  String[]
  videoName       String?
  resumeData      Json?
  resumeDocs      ResumeDoc[]
  relocate        Boolean        @default(false)
  searchable      Boolean        @default(true)
  alertFrequency  AlertFrequency @default(WEEKLY)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// A tailored resume + cover letter, snapshotting the JD it targeted.
// jobTitle/companyName are copies, not FKs — the doc outlives the posting.
model ResumeDoc {
  id          String           @id @default(cuid())
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  jobTitle    String
  companyName String?
  jobSlug     String?
  data        Json
  coverLetter String?
  source      String           @default("ai")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([profileId, createdAt(sort: Desc)])
}

model Company {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  website      String?
  logoUrl      String?
  location     String?
  about        String?
  orgType      String?
  size         String?
  planInterest String?
  galleryNames String[]
  videoName    String?
  members      User[]
  jobs         Job[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Job {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  location     String?
  workMode     WorkMode      @default(ONSITE)
  type         JobType       @default(FULL_TIME)
  category     String?
  salaryMin    Int?
  salaryMax    Int?
  currency     String        @default("USD")
  featured     Boolean       @default(false)
  status       JobStatus     @default(DRAFT)
  postedAt     DateTime?
  expiresAt    DateTime?
  applyUrl     String?
  applyEmail   String?
  applications Application[]
  savedBy      SavedJob[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, postedAt(sort: Desc)])
  @@index([companyId])
}

model Application {
  id          String            @id @default(cuid())
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  user        User?             @relation(fields: [userId], references: [id])
  userId      String?
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String?
  status      ApplicationStatus @default(SUBMITTED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, email])
  @@index([status])
  @@index([userId])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  image       String
  category    String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([category, publishedAt(sort: Desc)])
}

model PunchItem {
  id        String         @id
  done      Boolean        @default(false)
  updatedAt DateTime       @updatedAt
  comments  PunchComment[]
}

model PunchComment {
  id        String    @id @default(cuid())
  item      PunchItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  text      String
  createdAt DateTime  @default(now())

  @@index([itemId])
}

enum ProspectStatus {
  NEW
  QUEUED
  EMAILED
  REPLIED
  WON
  PASSED
}

model Prospect {
  id        String         @id @default(cuid())
  name      String
  orgType   String?
  location  String?
  state     String?
  contact   String?
  email     String?
  domain    String?
  roles     String?
  jobCount  Int            @default(1)
  source    String         @default("catholicjobs.com")
  status    ProspectStatus @default(NEW)
  notes     String?
  lastTouch DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([name, source])
  @@index([status])
}

model Freelancer {
  id        String              @id @default(cuid())
  slug      String?             @unique
  name      String
  email     String              @unique
  craft     String
  category  String
  city      String?
  state     String?
  rate      String?
  bio       String
  skills    String[]
  available Boolean             @default(true)
  featured  Boolean             @default(false)
  inquiries FreelancerInquiry[]
  portfolio PortfolioItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model PortfolioItem {
  id           String     @id @default(cuid())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  image        String // /portfolio/* path or data URL until S3 lands
  caption      String
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([freelancerId, sort])
}

model FreelancerInquiry {
  id           String     @id @default(cuid())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  name         String
  email        String
  message      String
  createdAt    DateTime   @default(now())

  @@index([freelancerId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String?
  message   String
  createdAt DateTime @default(now())
}

model SavedJob {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}
